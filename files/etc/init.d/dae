#!/bin/sh /etc/rc.common
# ============================================================
# dae 2.0 procd init — ImmortalWrt 25.12 (apk/procd 时代)
# 参考 douglarek/dae-openwrt + dae 官方 deb service
# 安装: cp 到 /etc/init.d/dae && chmod +x && /etc/init.d/dae enable
# ============================================================

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/dae
CONF_FILE=/etc/dae/config.dae

start_service() {
    # 启动前校验配置: 语法错直接拒绝启动 (响亮失败, 不静默半死)
    if ! "$PROG" validate -c "$CONF_FILE" >/dev/null 2>&1; then
        logger -t dae "config.dae 校验失败, 拒绝启动 — 先修配置!"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" run --disable-timestamp -c "$CONF_FILE"
    # eBPF 加载需要时间, 给足启动窗口
    procd_set_param timeout 120
    procd_set_param respawn
    # dae 并发高, 放宽 fd 限制 (参考官方 unit)
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# 热重载说明: dae 官方 reload 需连接运行实例 (dae reload <pid>),
# procd 下改配置后直接 /etc/init.d/dae restart 最可靠 (重启约 1-2s, 期间直连)
